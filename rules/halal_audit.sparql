PREFIX food: <http://example.org/food-compliance#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
  ?product food:requiresAuditFor food:Halal ; food:hasIssue ?issue .
  ?issue a food:ComplianceIssue ; food:forStandard food:Halal ;
    food:flaggedIngredient ?ingredient ; rdfs:label "Halal certification required." .
}
WHERE {
  ?product a food:FoodProduct ; food:containsIngredient+ ?ingredient .
  ?ingredient food:derivedFrom ?source .
  ?source rdf:type/rdfs:subClassOf* ?kind .
  FILTER(?kind IN (food:Bovine, food:Poultry, food:AnimalEnzyme))
  FILTER NOT EXISTS {
    ?ingredient food:hasCertificate ?cert .
    ?cert rdf:type/rdfs:subClassOf* food:HalalCert .
  }
  BIND(IRI(CONCAT("http://example.org/issue/", SHA256(CONCAT(STR(?product), "|halal-audit|", STR(?ingredient))))) AS ?issue)
}
