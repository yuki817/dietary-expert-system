@prefix food: <http://example.org/food-compliance#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Illustrative data only; not a compliance benchmark.
food:SampleBread a food:FoodProduct ;
    rdfs:label "Sample bread" ;
    food:containsIngredient food:SampleDough .
food:SampleDough a food:Ingredient ;
    rdfs:label "Sample dough" ;
    food:containsIngredient food:SampleFlour, food:SampleAdditive .
food:SampleFlour a food:Ingredient ; rdfs:label "Sample flour" .
food:SampleAdditive a food:Ingredient ; rdfs:label "Sample additive" ;
    food:hasFunctionalRole food:SampleRole ;
    food:derivedFrom food:SamplePorcineSource .
food:SamplePorcineSource a food:Porcine ; rdfs:label "Sample porcine source" .
food:SampleAlternative a food:Ingredient ; rdfs:label "Sample alternative" ;
    food:hasFunctionalRole food:SampleRole ; food:derivedFrom food:SamplePlantSource .
food:SamplePlantSource a food:PlantOrigin ; rdfs:label "Sample plant source" .
food:SampleRole a food:FunctionalRole ; rdfs:label "Sample role" .
